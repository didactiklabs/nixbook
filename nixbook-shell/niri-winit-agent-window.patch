+/// A window its rules open fullscreen stays fullscreen (and maximized under
+/// it), whatever the app asks, when NIRI_KEEP_FULLSCREEN is set: a nested
+/// niri showing one app at a time, where an app restoring its own window
+/// size (Firefox-based browsers do on start) would leave a half-width column.
+fn keeps_fullscreen(rules: &ResolvedWindowRules) -> bool {
+    rules.open_fullscreen == Some(true) && std::env::var_os("NIRI_KEEP_FULLSCREEN").is_some()
