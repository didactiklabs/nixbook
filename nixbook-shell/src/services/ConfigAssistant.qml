    function mentions(foldedQuestion, name) {
        return new RegExp(`\\b${root.escapeRe(root.fold(name))}\\b`).test(foldedQuestion);
    }
    function isNvim(i) {
        return root.data.kinds?.[i]?.startsWith("nvim:") ?? false;
