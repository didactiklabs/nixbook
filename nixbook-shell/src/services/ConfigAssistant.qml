    // The UI language's help, "en" when it isn't one of the four.
    function uiLang() {
        const code = Qt.locale().name.slice(0, 2);
        return root.helpExamples[code] ? code : "en";
    }
    // Markdown for the chat (/help) or plain lines for a tooltip.
    function helpText(lang = root.uiLang(), plain = false) {
        const h = root.helpExamples[lang] ?? root.helpExamples.en;
        // The Neovim line only where there are Neovim keymaps to ask about.
        const kinds = root.data?.kinds ?? [];
        const has = { nvim: (root.data?.nvim?.keymaps?.length ?? 0) > 0, os: kinds.includes("os"),
            howto: kinds.some(k => k.startsWith("howto:")) };
        const items = h.items.filter(([, , needs]) => !needs || has[needs]);
        const lines = items.map(([what, ex]) => plain ? `• ${what}: ${ex}` : `- **${what}**: “${ex.split(" · ").join("”, “")}”`);
        const text = `${plain ? h.title : `**${h.title}**`}\n${lines.join("\n")}\n${plain ? "" : "\n"}${h.more}\nEnglish · Français · Deutsch · Tiếng Việt`;
        return plain ? text : root.codeKeys(text);
    }

    function tr(lang, key, arg, arg2) {
        const s = (root.strings[lang] ?? root.strings.en)[key] ?? root.strings.en[key];
        return (arg === undefined ? s : s.replace("%1", arg)).replace("%2", arg2 ?? "%2");
    }
    // A fact in the question's language.
    function factText(i, lang) {
        if (lang === "en" || !root.data.factsI18n?.[lang]) return root.data.facts[i];
        return root.data.factsI18n[lang][i] ?? root.data.facts[i];
    }

    // ------------------------------------------------------------ language
    // Lower case, no accents (đ→d, ß→ss), punctuation as spaces.
    function fold(text) {
        let s = (text ?? "").toLowerCase().replace(/đ/g, "d").replace(/ß/g, "ss");
        if (s.normalize) s = s.normalize("NFD").replace(/[̀-ͯ]/g, "");
        return s.replace(/[^a-z0-9+]+/g, " ").trim();
    }
    readonly property var langWords: ({
        en: ["help", "find", "tell", "know", "give", "the", "what", "whats", "how", "is", "do", "does", "my", "to", "for", "can", "which", "where", "show", "make", "take", "turn", "go", "next", "list", "every", "all", "shortcut", "hotkey", "window", "screen", "app", "lock", "close", "open", "change", "yo", "hey", "hi", "hello", "thanks", "please", "i", "you", "installed", "enabled", "this", "current", "sound", "up", "down", "history"],
        fr: ["comment", "quel", "que", "fait", "sert", "quelle", "quoi", "est", "raccourci", "raccourcis", "ouvrir", "fermer", "le", "la", "les", "des", "du", "pour", "une", "un", "je", "mon", "ma", "mes", "faire", "mettre", "aller", "suis", "puis", "fenetre", "ecran", "tous", "toutes", "liste", "active", "installe", "salut", "bonjour", "merci", "son", "presse", "plein", "monter", "baisser", "verrouiller", "changer"],
        de: ["wie", "was", "macht", "tut", "welche", "welches", "welcher", "ich", "das", "der", "die", "den", "dem", "ist", "offnen", "offne", "offnet", "fenster", "bildschirm", "mit", "und", "zum", "zur", "mein", "meine", "machen", "zeig", "alle", "aktiviert", "installiert", "hallo", "danke", "wechseln", "schliessen", "einstellungen", "tastenkurzel", "nachsten", "sperren", "andere", "vollbild", "aktiv"],
        vi: ["khong", "cua", "lam", "sao", "phim", "tat", "mo", "dong", "khoa", "man", "hinh", "nen", "cai", "dat", "so", "am", "luong", "chup", "the", "nao", "gi", "duoc", "bat", "co", "de", "la", "toi", "cach", "chuyen", "sang", "tang", "giam", "xin", "chao", "cam", "on", "ca", "liet", "ke", "doi", "nhanh", "toan", "bo", "nho", "tam", "lich", "su"]
    })
    function detectLang(text) {
        // Letters only Vietnamese uses (â/ê/ô are French too).
        if (/[ăđơưạảấầẩẫậắằẳẵặẹẻẽếềểễệỉịọỏốồổỗộớờởỡợụủứừửữựỳỵỷỹ]/i.test(text)) return "vi";
        const tokens = root.fold(text).split(" ");
        const score = { en: 0, fr: /[éèêàçùœâôî]/i.test(text) ? 2 : 0, de: /[äöüß]/i.test(text) ? 2 : 0, vi: 0 };
        for (const lang of ["en", "fr", "de", "vi"])
            for (const w of tokens) if (root.langWords[lang].includes(w)) score[lang] += 1;
        let best = "en";
        // Two hits, or one when nothing is English ("que fait Mod+R ?").
        for (const lang of ["fr", "de", "vi"])
            if (score[lang] >= (score.en === 0 ? 1 : 2) && score[lang] > score[best]) best = lang;
        // A single foreign word ("Vollbild", "Zwischenablage-Verlauf").
        if (best === "en" && score.en === 0) {
            for (const lang of ["de", "fr", "vi"])
                if (tokens.some(w => (root.lexicon[lang] ?? []).some(([p]) => !p.startsWith("=") && !p.includes(" ") && w.startsWith(p) && p.length >= 5)))
                    return lang;
        }
        return best;
    }

