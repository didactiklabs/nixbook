/**
 * The config assistant: the chat's built-in "Config assistant" entry
 * (Ai.configAssistantId). No AI — every answer comes from this machine's
 * configuration, instantly and exactly. To chat with a model instead
 * (Gemini, an Ollama you run), pick it with /model.
 *
 * Understanding: the question's language is detected (English, French,
 * German, Vietnamese — accents optional), and a lexicon maps its words onto
 * the English vocabulary of the facts (prefix match for inflections).
 * Retrieval: keyword overlap weighted by rarity (IDF), light stemming,
 * synonyms; templated facts are indexed on their distinctive part only; the
 * previous question counts at half weight, for follow-ups.
 *
 * Answers (`answer`): greetings and help; listings (all shortcuts,
 * shortcuts about X, Neovim keymaps, enabled modules, settings set in Nix,
 * packages); "what does <leader>ff do in vim?"; "is
 * <module> enabled?"; "is <package> installed?"; "what does <key> do?"; a
 * request a keybinding answers (key + description) — all in `quickReply`;
 * otherwise the closest facts, or "I don't know" with tips when the
 * configuration doesn't cover the question.
 *
 * Facts: ~/.config/nixbook-shell/system-facts.json, generated by the Home
 * Manager module (customPkgs/nixbook-shell/scripts/assistant-facts.py), in
 * all four languages.
 */
Singleton {
    id: root

    readonly property bool ready: root.data !== null
    property var data: null
    property var _factWords: []
    property var _idf: ({})
    property real _maxIdf: 1
    property var _settingPaths: new Set()

    FileView {
        id: factsFile
        path: `${Directories.shellConfig}/system-facts.json`
        watchChanges: true
        onFileChanged: reload()
        onLoaded: root.load(factsFile.text())
        onLoadFailed: root.data = null
    }

