    function stem(w) {
        // Plural first, so "settings" and "setting" meet ("sett").
        if (w.length > 3 && w.endsWith("s") && !w.endsWith("ss") && !/(s|x|z|ch|sh)es$/.test(w)) w = w.slice(0, -1);
        if (w.length > 5 && w.endsWith("ing")) return w.slice(0, -3);
        if (w.length > 4 && w.endsWith("ed")) return w.slice(0, -2);
        if (w.length > 4 && /(s|x|z|ch|sh)es$/.test(w)) return w.slice(0, -2);
        if (w.length > 3 && w.endsWith("s") && !w.endsWith("ss")) return w.slice(0, -1);
        return w;
    }
    function words(text) {
        // Single letters are noise ("what's" → "s", which matched Mod+S).
        return (text.toLowerCase().match(/[a-z0-9]+/g) ?? []).filter(w => w.length > 1 && !root.stopWords.has(w))
            .map(w => root.stem(w)).filter(w => !root.stopWords.has(w));
    }

    // { facts: [{score, fact, i}] best first, coverage: 0..1 } — coverage is
    // how much of the question (IDF-weighted; words no fact contains weigh
    // the most) its best fact explains. For other languages only the English
    // words (own + lexicon) count: untranslated function words would drown it.
    function lookup(question, previous = "", lang = "en") {
        if (!root.data) return { facts: [], coverage: 0 };
        const direct = new Set(root.words(root.englishText(question, lang)));
        const context = new Set(root.words(root.englishText(previous, lang)).filter(w => !direct.has(w)));
        const extra = new Set();
        for (const w of direct)
            for (const s of (root.synonyms[w] ?? []))
                if (!direct.has(s)) extra.add(s);
        const weight = w => root._idf[w] ?? 0;
        // Neovim keymaps for questions about vim, the rest for the others.
        const vim = root.aboutVim(question);
        const scored = [];
        root.data.facts.forEach((fact, i) => {
            const fw = root._factWords[i];
            let score = 0;
            for (const w of direct) if (fw.has(w)) score += weight(w);
            for (const w of extra) if (fw.has(w)) score += 0.5 * weight(w);
            for (const w of context) if (fw.has(w)) score += 0.5 * weight(w);
            if (root.isNvim(i) !== vim) score *= 0.5;
            // Statements about the system before the many discovered toggles.
            if (root.data.kinds?.[i]?.startsWith("toggle:")) score *= 0.7;
            if (score > 0) scored.push({ score, fact, i });
        });
        // Ties (e.g. "settings": every pinned shell setting matches too): the
        // keybindings first — what can be done beats what is configured.
        scored.sort((a, b) => (b.score - a.score) || (root.isBind(b.i) - root.isBind(a.i)));
        if (scored.length === 0 || direct.size === 0) return { facts: scored.slice(0, 6), coverage: 0 };
        const top = scored[0].score;
        const facts = scored.filter(s => s.score >= 0.5 * top).slice(0, 6);
        let total = 0, covered = 0;
        const unknown = []; // content words no fact contains ("record" in "record my screen")
        const best = root._factWords[scored[0].i];
        for (const w of direct) {
            if (lang !== "en" && root._idf[w] === undefined) continue; // untranslated foreign word
            if (lang === "en" && root._idf[w] === undefined && root.langWords.en.includes(w)) continue; // filler
            if (root._idf[w] === undefined && w.length >= 4) unknown.push(w);
            const wt = root._idf[w] ?? root._maxIdf;
            total += wt;
            if (best.has(w)) covered += wt;
            else if ((root.synonyms[w] ?? []).some(s => best.has(s))) covered += wt / 2;
        }
        return { facts, coverage: total > 0 ? covered / total : 0, unknown };
    }


