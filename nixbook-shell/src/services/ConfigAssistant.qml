    // longest match; a matched word is replaced by its translation
    // ("fond d'écran" → wallpaper, not also "écran" → screen).
    function translate(question, lang) {
        let folded = ` ${root.fold(question)} `;
        const langs = [lang, "fr", "de", "en"].filter((l, i, a) => a.indexOf(l) === i && (l !== "vi" || lang === "vi"));
        // English extras add words, they don't replace them.
        const entries = [].concat(...langs.map(l => (root.lexicon[l] ?? []).map(([p, e]) => [p, e, l === "en"])));
        const extra = [];
        const consumed = [];
        for (const [pattern, english] of entries.filter(([p]) => p.includes(" ")).sort((a, b) => b[0].length - a[0].length)) {
            if (folded.includes(` ${pattern} `)) {
                extra.push(english);
                consumed.push(...pattern.split(" "));
                folded = folded.split(` ${pattern} `).join(" ");
            }
        }
        const kept = [];
        for (const w of folded.trim().split(/\s+/).filter(x => x.length > 0)) {
            let best = null;
            for (const [pattern, english, additive] of entries) {
                if (pattern.includes(" ")) continue;
                const exact = pattern.startsWith("=");
                const p = exact ? pattern.slice(1) : pattern;
                if (exact ? w === p : w.startsWith(p))
                    if (!best || p.length > best.p.length) best = { p, english, additive };
            }
            if (best) extra.push(best.english);
            if (best && !best.additive) consumed.push(w);
            else kept.push(w);
