    }

    function load(text) {
        try {
            const d = JSON.parse(text);
            const fw = d.facts.map((f, i) => new Set(root.words(root.indexText(f, d.kinds?.[i]))));
            const df = {};
            for (const set of fw)
                for (const w of set)
                    df[w] = (df[w] ?? 0) + 1;
            const idf = {};
            for (const w in df)
                idf[w] = Math.log(d.facts.length / df[w]);
            root._factWords = fw;
            root._idf = idf;
            root._maxIdf = Math.log(d.facts.length);
            root._settingPaths = new Set(d.settingPaths ?? []);
            root.data = d;
