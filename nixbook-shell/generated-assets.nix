{ pkgs }:
# The shell's generated assets: the themes' rasterised art, their synthesized
# sounds and the launcher's emoji list. Built from only what they are made of
# (the SVGs and the GIFs they embed, the sound scripts, the emoji sources), so
# editing QML doesn't redo them; qml.nix copies them into the tree at the
# same paths (assets/...).
let
  inherit (pkgs) lib;
  fs = lib.fileset;
  assets = ./src/assets;
  themeInputs =
    dir:
    fs.fileFilter (file: file.hasExt "svg" || file.hasExt "gif" || file.name == "sounds.py") (
      assets + "/${dir}"
    );
  themes = [
    "persona"
    "chiikawa"
    "cyberpunk"
    "ghibli"
  ];
in
pkgs.stdenvNoCC.mkDerivation {
  pname = "nixbook-shell-assets";
  version = "vendored-0ff392bc";
  src = fs.toSource {
    root = assets;
    fileset = fs.unions ([ (assets + "/synth.py") ] ++ map themeInputs themes);
  };

  dontConfigure = true;

  # Persona background art (persona/*.svg, generated by generate.py) is
  # rasterised here, at 2.5x its viewBox: PNGs are decoded at their own size
  # whatever the screen scale, so modules/common/Persona.qml can keep the
  # current variant's three textures cached and every panel reuses them.
  # (Qt keys SVG rasters by size x device pixel ratio, so each panel/screen
  # used to re-render its SVG — ~0.5 s before the art appeared.)
  nativeBuildInputs = [
    pkgs.resvg
    pkgs.python3
  ];
  buildPhase = ''
    runHook preBuild
    # The sound scripts share synth.py: no __pycache__ in the output.
    export PYTHONDONTWRITEBYTECODE=1
    for svg in persona/p*-{panel,tall,wide}.svg; do
      resvg --zoom 2.5 "$svg" "''${svg%.svg}.png"
    done
    # Chiikawa theme art (chiikawa/*.svg, generate.py): the sidebar patterns
    # and the wallpapers (1920x1080 viewBox: 4K). The character is
    # chiikawa.gif, momonga.gif and usagi.gif, shipped as they are.
    for svg in chiikawa/*.svg; do
      resvg --zoom 2 "$svg" "''${svg%.svg}.png"
    done
    # ...and its sounds, synthesized (chiikawa/sounds.py).
    python3 chiikawa/sounds.py chiikawa/sounds
    # Cyberpunk 2077 theme art (cyberpunk/*.svg, generate.py): the wallpapers
    # (1920x1080 viewBox: 4K), and its synthesized sounds.
    for svg in cyberpunk/*.svg; do
      resvg --zoom 2 "$svg" "''${svg%.svg}.png"
    done
    python3 cyberpunk/sounds.py cyberpunk/sounds
    # Studio Ghibli theme art (ghibli/*.svg, generate.py): the wallpapers
    # (1920x1080 viewBox: 4K), the sidebar patterns and the spirits, and its
    # synthesized sounds.
    for svg in ghibli/*.svg; do
      resvg --zoom 2 "$svg" "''${svg%.svg}.png"
    done
    python3 ghibli/sounds.py ghibli/sounds
    # Persona's synthesized sounds (persona/sounds.py): the timers', and P3R's
    # and P4's own chime and critical sound (P5's are the registry's,
    # assets/sounds).
    python3 persona/sounds.py persona/sounds
    # The launcher's emoji list (services/Emojis.qml): Unicode's emojis with
    # CLDR's English keywords.
    python3 ${./scripts/emojis.py} \
      ${pkgs.unicode-emoji}/share/unicode/emoji/emoji-test.txt \
      ${pkgs.cldr-annotations}/share/unicode/cldr/common/annotations/en.xml \
      ${pkgs.cldr-annotations}/share/unicode/cldr/common/annotationsDerived/en.xml \
      >emojis.txt
    runHook postBuild
  '';

  # Only what was generated, at its path under assets/.
  installPhase = ''
    runHook preInstall
    for theme in ${lib.concatStringsSep " " themes}; do
      mkdir -p "$out/$theme"
      cp "$theme"/*.png "$out/$theme/"
      cp -r "$theme/sounds" "$out/$theme/"
    done
    cp emojis.txt "$out/"
    runHook postInstall
  '';
}
