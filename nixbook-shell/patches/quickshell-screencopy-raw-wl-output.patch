+WlrScreencopyContext::OutputTransformQuery::~OutputTransformQuery() { this->releaseOutput(); }
+
+void WlrScreencopyContext::OutputTransformQuery::releaseOutput() {
+	if (this->output == nullptr) return;
+	if (wl_proxy_get_version(reinterpret_cast<wl_proxy*>(this->output)) >= WL_OUTPUT_RELEASE_SINCE_VERSION) { // NOLINT
+		wl_output_release(this->output);
+	} else {
+		wl_output_destroy(this->output);
+	}
+	this->output = nullptr;
 }
 
