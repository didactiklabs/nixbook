+	this->output = static_cast<::wl_output*>(wl_registry_bind( // NOLINT
 	    screen->display()->wl_registry(),
 	    static_cast<QWaylandScreenReflector*>(screen)->globalId(), // NOLINT
+	    &wl_output_interface,
 	    3
-	);
+	));
