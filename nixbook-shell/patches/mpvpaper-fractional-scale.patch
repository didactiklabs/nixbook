+static void preferred_scale(void *data, struct wp_fractional_scale_v1 *fractional_scale, uint32_t scale) {
+    (void)fractional_scale;
+
+    struct display_output *output = data;
+    if (output->scale120 == scale) return;
+    output->scale120 = scale;
+    // The next frame is drawn at the new size.
+    if (output->egl_window && output->width && output->height)
+        wl_egl_window_resize(output->egl_window, buffer_size(output, output->width),
+                buffer_size(output, output->height), 0, 0);
+}
+
+static const struct wp_fractional_scale_v1_listener fractional_scale_listener = {
+    .preferred_scale = preferred_scale,
+};
