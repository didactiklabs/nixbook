 static void exit_mpvpaper(int reason) {
+    // One exit only: a second thread getting here (mpv's shutdown event
+    // while a signal's exit runs) freed mpv twice and ran exit() beside the
+    // first one, a crash at every other stop
+    if (atomic_flag_test_and_set(&exiting)) {
+        for (;;)
+            pause();
+    }
