index 733ef00..981218a 100644
--- a/core/internal/providers/google/quota.go
+++ b/core/internal/providers/google/quota.go
@@ -41,6 +41,10 @@ type deferredRetry struct {
 }
 
 func (e *deferredRetry) Error() string {
+	// Google's own answer (429, rateLimitExceeded, a 5xx…) says why.
+	if e.cause != nil {
+		return fmt.Sprintf("Google API retry deferred for %s (%v)", e.RetryAfter(), e.cause)
+	}
 	return fmt.Sprintf("Google API retry deferred for %s", e.RetryAfter())
 }
 func (e *deferredRetry) Unwrap() error             { return e.cause }
diff --git a/core/internal/providers/google/tasklists.go b/core/internal/providers/google/tasklists.go
new file mode 100644
index 0000000..4baa203
--- /dev/null
+++ b/core/internal/providers/google/tasklists.go
@@ -0,0 +1,68 @@
+package google
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+
+	"google.golang.org/api/googleapi"
+	gtasks "google.golang.org/api/tasks/v1"
+
+	cal "github.com/AvengeMedia/dankcalendar/core/internal/calendar"
+)
+
+// The account's task lists themselves: create, rename, delete (the
+// tasks.listCreate / listRename / listDelete IPC methods).
+
+func (p *Provider) CreateTaskList(ctx context.Context, name string) (cal.Calendar, error) {
+	created, err := googleCall(ctx, p, false, func() (*gtasks.TaskList, error) {
+		return p.tasksSvc.Tasklists.Insert(&gtasks.TaskList{Title: name}).Context(ctx).Do()
+	})
+	if err != nil {
+		return cal.Calendar{}, fmt.Errorf("create google task list: %w", classifyAuthErr(err))
+	}
+	return cal.Calendar{
+		AccountID:           p.account.ID,
+		RemoteID:            taskListPrefix + created.Id,
+		Name:                created.Title,
+		SupportedComponents: []string{cal.ComponentVTodo},
+	}, nil
+}
+
+func (p *Provider) RenameTaskList(ctx context.Context, c cal.Calendar, name string) error {
+	if !strings.HasPrefix(c.RemoteID, taskListPrefix) {
+		return errors.New("not a task list")
+	}
+	_, err := googleCall(ctx, p, false, func() (*gtasks.TaskList, error) {
+		return p.tasksSvc.Tasklists.Patch(taskListID(c.RemoteID), &gtasks.TaskList{Title: name}).Context(ctx).Do()
+	})
+	if err != nil {
+		return fmt.Errorf("rename google task list: %w", classifyAuthErr(err))
+	}
+	return nil
+}
+
+func (p *Provider) DeleteTaskList(ctx context.Context, c cal.Calendar) error {
+	if !strings.HasPrefix(c.RemoteID, taskListPrefix) {
+		return errors.New("not a task list")
+	}
+	_, err := googleCall(ctx, p, false, func() (*struct{}, error) {
+		return nil, p.tasksSvc.Tasklists.Delete(taskListID(c.RemoteID)).Context(ctx).Do()
+	})
+	if err == nil {
+		return nil
+	}
+	var apiErr *googleapi.Error
+	if errors.As(err, &apiErr) {
+		switch apiErr.Code {
+		case http.StatusNotFound, http.StatusGone:
+			return nil
+		case http.StatusBadRequest:
+			// Google refuses to delete the account's default list.
+			return errors.New("google won't delete this list (the default list can't be deleted)")
+		}
+	}
+	return fmt.Errorf("delete google task list: %w", classifyAuthErr(err))
+}
diff --git a/core/internal/providers/google/tasklists_test.go b/core/internal/providers/google/tasklists_test.go
new file mode 100644
index 0000000..c520c7d
--- /dev/null
+++ b/core/internal/providers/google/tasklists_test.go
@@ -0,0 +1,101 @@
+package google
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"google.golang.org/api/googleapi"
+	"google.golang.org/api/option"
+	gtasks "google.golang.org/api/tasks/v1"
+
+	cal "github.com/AvengeMedia/dankcalendar/core/internal/calendar"
+)
+
+// A fake Tasks API: records each request, answers create and rename, and
+// refuses to delete the list "default" the way Google does.
+func taskListsServer(t *testing.T, calls *[]string) *Provider {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		*calls = append(*calls, r.Method+" "+r.URL.Path+" "+strings.TrimSpace(string(body)))
+		switch {
+		case r.Method == http.MethodPost && strings.HasSuffix(r.URL.Path, "/users/@me/lists"):
+			var in gtasks.TaskList
+			_ = json.Unmarshal(body, &in)
+			_ = json.NewEncoder(w).Encode(gtasks.TaskList{Id: "new1", Title: in.Title})
+		case r.Method == http.MethodPatch:
+			_, _ = w.Write(body)
+		case r.Method == http.MethodDelete && strings.HasSuffix(r.URL.Path, "/default"):
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = w.Write([]byte(`{"error":{"code":400,"message":"Invalid Value"}}`))
+		case r.Method == http.MethodDelete && strings.HasSuffix(r.URL.Path, "/gone"):
+			w.WriteHeader(http.StatusNotFound)
+		case r.Method == http.MethodDelete:
+			w.WriteHeader(http.StatusNoContent)
+		default:
+			w.WriteHeader(http.StatusNotImplemented)
+		}
+	}))
+	t.Cleanup(srv.Close)
+	svc, err := gtasks.NewService(context.Background(), option.WithEndpoint(srv.URL+"/"), option.WithHTTPClient(srv.Client()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &Provider{account: cal.Account{ID: "acc-tasklists-test"}, tasksSvc: svc}
+}
+
+func TestTaskLists(t *testing.T) {
+	var calls []string
+	p := taskListsServer(t, &calls)
+	ctx := context.Background()
+
+	created, err := p.CreateTaskList(ctx, "Groceries")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if created.RemoteID != taskListPrefix+"new1" || created.Name != "Groceries" || created.AccountID != "acc-tasklists-test" {
+		t.Fatalf("created: %+v", created)
+	}
+
+	list := cal.Calendar{RemoteID: taskListPrefix + "abc"}
+	if err := p.RenameTaskList(ctx, list, "Errands"); err != nil {
+		t.Fatal(err)
+	}
+	if last := calls[len(calls)-1]; !strings.HasPrefix(last, "PATCH /tasks/v1/users/@me/lists/abc") || !strings.Contains(last, `"title":"Errands"`) {
+		t.Fatalf("rename call: %s", last)
+	}
+
+	if err := p.DeleteTaskList(ctx, list); err != nil {
+		t.Fatal(err)
+	}
+	if err := p.DeleteTaskList(ctx, cal.Calendar{RemoteID: taskListPrefix + "gone"}); err != nil {
+		t.Fatalf("an already deleted list: %v", err)
+	}
+	err = p.DeleteTaskList(ctx, cal.Calendar{RemoteID: taskListPrefix + "default"})
+	if err == nil || !strings.Contains(err.Error(), "default list") {
+		t.Fatalf("the default list: %v", err)
+	}
+
+	// Event calendars aren't task lists.
+	if err := p.RenameTaskList(ctx, cal.Calendar{RemoteID: "primary"}, "x"); err == nil {
+		t.Fatal("renamed an event calendar")
+	}
+	if err := p.DeleteTaskList(ctx, cal.Calendar{RemoteID: "primary"}); err == nil {
+		t.Fatal("deleted an event calendar")
+	}
+}
+
+// A deferral names Google's answer, so the logs say why a call waits.
+func TestDeferredRetryNamesCause(t *testing.T) {
+	cause := &googleapi.Error{Code: 429, Message: "Too Many Requests"}
+	err := (&deferredRetry{until: time.Now().Add(time.Second), now: time.Now, cause: cause}).Error()
+	if !strings.Contains(err, "retry deferred") || !strings.Contains(err, "429") {
+		t.Fatalf("message: %s", err)
+	}
+}
