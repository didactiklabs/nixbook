diff --git a/core/internal/ipc/tasklists.go b/core/internal/ipc/tasklists.go
new file mode 100644
index 0000000..f55866e
--- /dev/null
+++ b/core/internal/ipc/tasklists.go
@@ -0,0 +1,140 @@
+package ipc
+
+import (
+	"context"
+	"strings"
+
+	"github.com/AvengeMedia/dankcalendar/core/internal/calendar"
+	"github.com/AvengeMedia/dankgo/log"
+)
+
+// taskListManager: a provider that can create, rename and delete the task
+// lists themselves (Google).
+type taskListManager interface {
+	CreateTaskList(ctx context.Context, name string) (calendar.Calendar, error)
+	RenameTaskList(ctx context.Context, c calendar.Calendar, name string) error
+	DeleteTaskList(ctx context.Context, c calendar.Calendar) error
+}
+
+func handleTaskListCreate(ctx context.Context, w *ConnWriter, req Request, deps Deps) {
+	accountID := ParamString(req.Params, "accountId")
+	name := strings.TrimSpace(ParamString(req.Params, "name"))
+	if accountID == "" || name == "" {
+		w.RespondError(req.ID, "accountId and name are required")
+		return
+	}
+	acc, err := deps.Repo.GetAccount(ctx, accountID)
+	if err != nil {
+		w.RespondError(req.ID, err.Error())
+		return
+	}
+	provider, err := deps.Registry.Build(ctx, calendar.Account{
+		ID:          acc.ID,
+		Kind:        calendar.AccountKind(acc.Kind),
+		DisplayName: acc.DisplayName,
+		Settings:    acc.Settings,
+	}, deps.Secrets)
+	if err != nil {
+		w.RespondError(req.ID, err.Error())
+		return
+	}
+	defer provider.Close()
+	manager, ok := provider.(taskListManager)
+	if !ok {
+		w.RespondError(req.ID, "this account can't create task lists")
+		return
+	}
+	created, err := manager.CreateTaskList(ctx, name)
+	if err != nil {
+		w.RespondError(req.ID, err.Error())
+		return
+	}
+
+	// Sync so the list is stored with an id before the reply.
+	if deps.Sync != nil {
+		if err := deps.Sync.SyncAccount(ctx, acc); err != nil {
+			log.Warnf("sync after task list create: %v", err)
+		}
+	}
+	calendarID := ""
+	if cals, err := deps.Repo.ListCalendarsForAccount(ctx, acc.ID); err == nil {
+		for _, c := range cals {
+			if c.RemoteID == created.RemoteID {
+				calendarID = c.ID
+			}
+		}
+	}
+	if deps.Bus != nil {
+		deps.Bus.Publish("calendars", map[string]any{"type": "created", "accountId": acc.ID})
+	}
+	w.Respond(req.ID, map[string]any{"calendarId": calendarID, "name": created.Name})
+}
+
+func handleTaskListRename(ctx context.Context, w *ConnWriter, req Request, deps Deps) {
+	id := ParamString(req.Params, "calendarId")
+	name := strings.TrimSpace(ParamString(req.Params, "name"))
+	if id == "" || name == "" {
+		w.RespondError(req.ID, "calendarId and name are required")
+		return
+	}
+	provider, domCal, err := providerForCalendar(ctx, deps, id)
+	if err != nil {
+		w.RespondError(req.ID, err.Error())
+		return
+	}
+	defer provider.Close()
+	manager, ok := provider.(taskListManager)
+	if !ok {
+		w.RespondError(req.ID, "this account can't rename task lists")
+		return
+	}
+	if err := manager.RenameTaskList(ctx, domCal, name); err != nil {
+		w.RespondError(req.ID, err.Error())
+		return
+	}
+	// The provider's name now; a local override would hide it.
+	if err := deps.Repo.SetCalendarNameOverride(ctx, id, ""); err != nil {
+		log.Warnf("clear name override after rename: %v", err)
+	}
+	if entCal, err := deps.Repo.GetCalendar(ctx, id); err == nil && deps.Sync != nil && entCal.Edges.Account != nil {
+		if err := deps.Sync.SyncAccount(ctx, entCal.Edges.Account); err != nil {
+			log.Warnf("sync after task list rename: %v", err)
+		}
+	}
+	if deps.Bus != nil {
+		deps.Bus.Publish("calendars", map[string]any{"type": "changed", "calendarId": id})
+	}
+	w.Respond(req.ID, map[string]any{"calendarId": id, "name": name})
+}
+
+func handleTaskListDelete(ctx context.Context, w *ConnWriter, req Request, deps Deps) {
+	id := ParamString(req.Params, "calendarId")
+	if id == "" {
+		w.RespondError(req.ID, "calendarId is required")
+		return
+	}
+	provider, domCal, err := providerForCalendar(ctx, deps, id)
+	if err != nil {
+		w.RespondError(req.ID, err.Error())
+		return
+	}
+	defer provider.Close()
+	manager, ok := provider.(taskListManager)
+	if !ok {
+		w.RespondError(req.ID, "this account can't delete task lists")
+		return
+	}
+	if err := manager.DeleteTaskList(ctx, domCal); err != nil {
+		w.RespondError(req.ID, err.Error())
+		return
+	}
+	// A sync never drops a list: remove the local copy (and its tasks).
+	if err := deps.Repo.DeleteCalendar(ctx, id); err != nil {
+		w.RespondError(req.ID, err.Error())
+		return
+	}
+	if deps.Bus != nil {
+		deps.Bus.Publish("calendars", map[string]any{"type": "deleted", "calendarId": id})
+	}
+	w.Respond(req.ID, map[string]any{"deleted": true})
+}
