+        // Sleeps until mpv has an event (a second at most, for the slideshow
+        // and the loop's end), instead of asking a hundred times a second
+        mpv_event *event = mpv_wait_event(mpv, 1);
 
         if (event->event_id == MPV_EVENT_SHUTDOWN) {
             exit_mpvpaper(EXIT_SUCCESS);
@@ -480,8 +485,6 @@
                 }
