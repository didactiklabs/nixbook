+// Whether objects are incubated a fraction of a frame at a time, between the
+// steps of running animations (QSGThreadedRenderLoop::interleaveIncubation()).
+bool QsIncubationController::interleaveIncubation() const {
+	if (!this->renderLoop) return false;
+	if (!this->frameDriver) return this->renderLoop->interleaveIncubation();
+	if (!this->frameDriver->isRunning()) return false;
+
+	for (const auto* window: this->renderLoop->windows()) {
+		if (window->isVisible() && window->isExposed()) return true;
+	}
+
+	return false;
+}
