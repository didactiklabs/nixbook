+def _gecko_expiry(value: int) -> float:
+    """moz_cookies.expiry: seconds, milliseconds in newer Firefox."""
+    if not value:
+        return -1.0
+    return value / 1000.0 if value > 100_000_000_000 else float(value)
+
+
+def _gecko_rows(profile: BrowserProfile) -> list[sqlite3.Row]:
+    """A Firefox-family profile's LinkedIn rows of moz_cookies (plain text),
+    from a copy (the browser keeps the database locked), the default
+    container's first."""
+    temp_dir, db_copy = _copy_cookies_db(profile.cookies_db)
+    try:
+        connection = sqlite3.connect(f"file:{db_copy}?mode=ro", uri=True)
+        try:
+            connection.row_factory = sqlite3.Row
+            rows = connection.execute(
+                "SELECT host, name, value, path, expiry, lastAccessed, isSecure, "
+                "isHttpOnly, sameSite, originAttributes FROM moz_cookies"
+            ).fetchall()
+        finally:
+            connection.close()
+    finally:
+        shutil.rmtree(temp_dir, ignore_errors=True)
+    rows = [r for r in rows if "linkedin.com" in (r["host"] or "")]
+    default = [r for r in rows if not r["originAttributes"]]
+    return default or rows
+
+
+def _gecko_cookies(profile: BrowserProfile) -> list[LinkedInCookie]:
+    cookies = [
+        LinkedInCookie(
+            name=row["name"],
+            value=row["value"] or "",
+            domain=row["host"],
+            path=row["path"] or "/",
+            expires=_gecko_expiry(row["expiry"] or 0),
+            secure=bool(row["isSecure"]),
+            http_only=bool(row["isHttpOnly"]),
+            # moz_cookies.sameSite: 0 None, 1 Lax, 2 Strict.
+            same_site={0: "None", 1: "Lax", 2: "Strict"}.get(row["sameSite"], "Lax"),
+        )
+        for row in _gecko_rows(profile)
+    ]
+    logger.info(
+        "Extracted %d LinkedIn cookies from %s/%s",
+        len(cookies),
+        profile.browser,
+        profile.profile_dir_name,
+    )
+    return cookies
+
