+def gecko_profiles(browser_key: str) -> list[tuple[Path, Path, str]]:
+    """``(root, profile_path, name)`` of a Firefox-family browser's profiles
+    with a cookies.sqlite, from each root's profiles.ini (Linux only)."""
+    import configparser
+
+    spec = SUPPORTED_BROWSERS[browser_key]
+    if sys.platform == "darwin" or os.name == "nt":
+        return []
+    found: list[tuple[Path, Path, str]] = []
+    seen: set[Path] = set()
+    for sub in cast("tuple[str, ...]", spec.get("gecko_roots", ())):
+        root = Path.home() / sub
+        ini = root / "profiles.ini"
+        if not ini.is_file():
+            continue
+        parser = configparser.RawConfigParser()
+        try:
+            parser.read(ini)
+        except configparser.Error:
+            continue
+        for section in parser.sections():
+            if not section.startswith("Profile"):
+                continue
+            raw = parser.get(section, "Path", fallback="")
+            if not raw:
+                continue
+            relative = parser.get(section, "IsRelative", fallback="1") == "1"
+            path = (root / raw) if relative else Path(raw)
+            resolved = path.resolve() if path.exists() else path
+            if resolved in seen or not (path / "cookies.sqlite").is_file():
+                continue
+            seen.add(resolved)
+            found.append((root, path, parser.get(section, "Name", fallback=path.name)))
+    return found
+
