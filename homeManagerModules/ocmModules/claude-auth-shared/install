#!/bin/sh
# Runs inside the workspace container. The host's Claude Code login is
# bind-mounted onto ~/.claude/.credentials.json by the module's `mounts`
# (optional: skipped while the host has no login), so there is nothing to
# write there; this reports whether the mount is in place.
#
# A fresh workspace has no ~/.claude.json, and Claude Code then runs its
# first-start onboarding — which ends in the login screen — whatever the
# credentials file holds. Marking onboarding done makes it use the shared
# login. Other ~/.claude.json keys are left alone; idempotent.
set -e

creds="$HOME/.claude/.credentials.json"
config="$HOME/.claude.json"

if [ "$(jq -r '.hasCompletedOnboarding // false' "$config" 2>/dev/null)" != "true" ]; then
  tmp="$(mktemp "$HOME/.claude.json.XXXXXX")"
  { jq '.hasCompletedOnboarding = true' "$config" 2>/dev/null || echo '{"hasCompletedOnboarding":true}'; } >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$config"
fi

if grep -qF " $creds " /proc/self/mountinfo 2>/dev/null; then
  echo "claude-auth-shared: Claude login shared with the host"
else
  echo "claude-auth-shared: no Claude login on the host yet; log in there and restart the workspace"
fi
