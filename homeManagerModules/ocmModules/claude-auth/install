#!/bin/sh
# Runs inside the workspace container. Writes the host's Claude Code OAuth
# credentials, handed over base64-encoded by the host resolve hook
# ($OCM_CREDENTIALS), to ~/.claude/.credentials.json.
#
# The file is only replaced when the host login is at least as fresh as the
# workspace's own (compared on claudeAiOauth.expiresAt), so a token the
# workspace already refreshed is never rolled back to an older one.
#
# When the file is bind-mounted from the host (the claude-auth-shared module),
# it already is the host's file and is left alone. Idempotent, so reconcile can
# re-run it.
set -e

dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
creds="$dir/.credentials.json"

if grep -qF " $creds " /proc/self/mountinfo 2>/dev/null; then
  echo "claude-auth: $creds is shared from the host (bind mount), nothing to import"
  exit 0
fi

if [ -z "$OCM_CREDENTIALS" ]; then
  echo "claude-auth: no Claude login found on the host (nothing written)"
  exit 0
fi

mkdir -p "$dir"
umask 077
new="$(mktemp "$dir/.credentials.json.XXXXXX")"
trap 'rm -f "$new"' EXIT
printf '%s' "$OCM_CREDENTIALS" | base64 -d >"$new"

expires() { jq -r '.claudeAiOauth.expiresAt // 0' "$1" 2>/dev/null || echo 0; }
if [ -s "$creds" ] && [ "$(expires "$creds")" -gt "$(expires "$new")" ]; then
  echo "claude-auth: workspace login is newer than the host's, kept"
  exit 0
fi

chmod 600 "$new"
mv -f "$new" "$creds"
trap - EXIT
echo "claude-auth: Claude credentials imported from the host"
