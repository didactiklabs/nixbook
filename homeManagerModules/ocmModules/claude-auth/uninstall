#!/bin/sh
# Removes the imported Claude credentials (logging claude out of the workspace).
# A file bind-mounted from the host is never touched. Best-effort.
set -e

creds="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"

if grep -qF " $creds " /proc/self/mountinfo 2>/dev/null; then
  echo "claude-auth: $creds is shared from the host, left in place"
  exit 0
fi

rm -f "$creds"
echo "claude-auth: Claude credentials removed"
