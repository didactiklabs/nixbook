+    -- tog_upscale (nixbook): upscale.lua's picture menu; dimmed while
+    -- nothing is on
+    ne = new_element('tog_upscale', 'button')
+    ne.content = function ()
+        local u = mp.get_property_native('user-data/upscale') or {}
+        if (u.mode or 0) == 0 and not u.smooth then
+            return '{\\alpha&H90&}' .. icons.upscale
+        end
+        return icons.upscale
+    end
+    ne.visible = (osc_param.playresx >= 650)
+    ne.tooltip_style = osc_styles.Tooltip
+    ne.tooltipF = function ()
+        local u = mp.get_property_native('user-data/upscale') or {}
+        local msg = 'Picture: ' .. ((u.mode or 0) == 0 and 'upscaling off' or u.name)
+        if u.smooth then msg = msg .. ', smooth motion' end
+        return msg .. ' (click: menu, right click: upscaling off)'
+    end
+    ne.eventresponder['mbtn_left_up'] =
+        function () mp.commandv('script-message', 'upscale-menu') end
+    ne.eventresponder['mbtn_right_up'] =
+        function () mp.commandv('script-message', 'upscale-off') end
+    ne.eventresponder['enter'] =
+        function () mp.commandv('script-message', 'upscale-menu') end
+
+    -- tog_quality (nixbook): quality.lua's menu, for a video with several
+    -- qualities (YouTube…); not drawn for the others
+    ne = new_element('tog_quality', 'button')
+    ne.content = function ()
