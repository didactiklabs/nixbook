+    fn opaque_regions(&self, scale: Scale<f64>) -> OpaqueRegions<i32, Physical> {
+        // The shader mixes bg_color behind the texture: with an opaque bg_color, everything it
+        // draws is opaque, which is inside the clip geometry minus its rounded corners. Saying
+        // so lets the damage tracker skip what is underneath (a video wallpaper on the Bottom
+        // layer, desktop widgets): before, every change there re-rendered the windows above.
+        //
+        // Conservative: nothing for a subregion (only parts are drawn), the clip rounded inward
+        // and each corner's whole square left out, rounded outward.
+        let Some(clip_geo) = self.clip_geo else {
+            return OpaqueRegions::default();
+        };
+        if !self.bg_color.is_opaque() || self.subregion.is_some() {
+            return OpaqueRegions::default();
+        }
+        let Some(opaque) = self.geometry.intersection(clip_geo) else {
+            return OpaqueRegions::default();
+        };
+
+        let elem_loc = self.geometry(scale).loc;
+        let mut opaque = opaque.to_physical_precise_down(scale);
+        opaque.loc -= elem_loc;
+
+        if self.corner_radius == CornerRadius::default() {
+            return OpaqueRegions::from_slice(&[opaque]);
+        }
+        let corners = ClippedSurfaceRenderElement::<GlesRenderer>::rounded_corners(
+            clip_geo,
+            self.corner_radius,
+        )
+        .into_iter()
+        .map(|rect| {
+            let mut rect = rect.to_physical_precise_up(scale);
+            rect.loc -= elem_loc;
+            rect
+        });
+        OpaqueRegions::from_slice(&Rectangle::subtract_rects_many([opaque], corners))
     }
 }
 
